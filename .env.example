# Copy to .env (gitignored). `npm start` loads it automatically.
# Leave both keys unset to make each person enter their own key in the UI.
# Gemini is tried first; OpenRouter is the fallback when Gemini errors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
# Comma-separated; first is preferred, the rest are fallbacks when it is rate-limited.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-s-2.1:free
PORT=3188
